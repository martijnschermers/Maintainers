@page "/login"
@rendermode InteractiveServer


<div class="login-form">
    <EditForm Model="LoginData" OnValidSubmit="HandleSubmit" FormName="LoginForm" class="login-form">
        <DataAnnotationsValidator />

        <h1>Login</h1>

        <div>
            <label for="username">Username</label>
            <InputText @bind-Value="LoginData.Username" type="text" id="username" name="username" />
            <ValidationMessage For="@(() => LoginData.Username)" class="text-danger" />
        </div>
        <div>
            <label for="password">Password</label>
            <InputText @bind-Value="LoginData.Password" type="password" id="password" name="password" />
            <ValidationMessage For="@(() => LoginData.Password)" class="text-danger" />
        </div>
        <button type="submit">Login</button>
    </EditForm>


    @if (LoginData != null && !string.IsNullOrEmpty(LoginData.Username))
    {
        <div class="alert alert-success mt-3">
            <p>Welcome back, @LoginData.Username!</p>
        </div>
    }
</div>

@code {
    [Inject]
    private IdentityService IdentityService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "LoginForm")]
    private LoginModel LoginData { get; set; } = new LoginModel();

    private async Task HandleSubmit()
    {
        Console.WriteLine($"Username: {LoginData.Username}");
        Console.WriteLine($"Password: {LoginData.Password}");

        var isAuthenticated = await IdentityService.AuthenticateUserAsync(LoginData.Username, LoginData.Password);

        if (isAuthenticated)
        {
            Console.WriteLine("User authenticated successfully.");
            // Redirect to a protected page or perform other actions
            NavigationManager.NavigateTo("/"); // Example: Redirect to a dashboard page
        }
        else
        {
            Console.WriteLine("Authentication failed. Invalid username or password.");
            // Show an error message to the user
        }
    }
}