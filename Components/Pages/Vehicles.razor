@page "/vehicles"
@layout MainLayout

<PageTitle>Vehicles</PageTitle>

<h1>Vehicles</h1>

<form @onsubmit="AddVehicle">
    <div>
        <label for="model">Model</label>
        <input type="text" id="model" name="model" @bind="newVehicleModel" />
    </div>
    <div>
        <label for="year">Year</label>
        <input type="number" id="year" name="year" @bind="newVehicleYear" />
    </div>
    <div>
        <label for="make">Make</label>
        <input type="text" id="make" name="make" @bind="newVehicleMake" />
    </div>
    <button type="button" @onclick="AddVehicle">Add Vehicle</button>
</form>


@if (vehicles.Count == 0)
{
    <p class="text-muted">No vehicles added yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Year</th>
                    <th>Make</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in vehicles)
                {
                    <tr>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.Year</td>
                        <td>@vehicle.Make</td>
                        <td>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => RemoveVehicle(vehicle.VehicleId)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string[] _errors = [];

    private List<Vehicle> vehicles = new();
    private string newVehicleModel = "";
    private int newVehicleYear = DateTime.Now.Year;
    private string newVehicleMake = "";
    private int vehicleIdCounter = 1;

    private void AddVehicle()
    {
        if (string.IsNullOrWhiteSpace(newVehicleModel) || string.IsNullOrWhiteSpace(newVehicleMake))
        {
            return;
        }

        vehicles.Add(new Vehicle
        {
            VehicleId = vehicleIdCounter++,
            Model = newVehicleModel,
            Year = newVehicleYear,
            Make = newVehicleMake
        });

        newVehicleModel = "";
        newVehicleYear = DateTime.Now.Year;
        newVehicleMake = "";
    }

    private void RemoveVehicle(int id)
    {
        vehicles.RemoveAll(v => v.VehicleId == id);
    }
}
