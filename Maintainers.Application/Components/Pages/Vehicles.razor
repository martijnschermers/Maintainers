@page "/vehicles"
@layout MainLayout

<PageTitle>Vehicles</PageTitle>

<h1>Vehicles</h1>

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors" OnEnterPressed="@(() => _form.ValidateAsync())">
                <MudTextField T="string" Label="Vehicle" Required="true" RequiredError="Vehicle is required!" />
                <MudDatePicker T="DateTime?" Label="Purchase Date" Required="true" RequiredError="Purchase date is required!" />
                <div class="d-flex">
                    <MudRadioGroup T="string" Required="true" RequiredError="Vehicle type is required!">
                        <MudRadio Value="@("Car")">Car</MudRadio>
                        <MudRadio Value="@("Truck")">Truck</MudRadio>
                        <MudRadio Value="@("Motorcycle")">Motorcycle</MudRadio>
                        <MudRadio Value="@("Scooter")">Scooter/Moped</MudRadio>
                        <MudRadio Value="@("Other")">Other</MudRadio>
                    </MudRadioGroup>
                </div>
                <div class="d-flex align-center justify-space-between">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_success)" Class="ml-auto">Add Vehicle</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
</MudGrid>


@if (vehicles.Count == 0)
{
    <p class="text-muted">No vehicles added yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Year</th>
                    <th>Make</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in vehicles)
                {
                    <tr>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.Year</td>
                        <td>@vehicle.Make</td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => RemoveVehicle(vehicle.Id)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _success;
    private MudForm _form;
    private string _password;
    private string[] _errors = [];

    private List<Vehicle> vehicles = new();
    private string newVehicleModel = "";
    private int newVehicleYear = DateTime.Now.Year;
    private string newVehicleMake = "";
    private int vehicleIdCounter = 1;

    private void AddVehicle()
    {
        if (string.IsNullOrWhiteSpace(newVehicleModel) || string.IsNullOrWhiteSpace(newVehicleMake))
        {
            return;
        }

        vehicles.Add(new Vehicle
        {
            Id = vehicleIdCounter++,
            Model = newVehicleModel,
            Year = newVehicleYear,
            Make = newVehicleMake
        });

        newVehicleModel = "";
        newVehicleYear = DateTime.Now.Year;
        newVehicleMake = "";
    }

    private void RemoveVehicle(int id)
    {
        vehicles.RemoveAll(v => v.Id == id);
    }

    private class Vehicle
    {
        public int Id { get; set; }
        public string Model { get; set; } = "";
        public int Year { get; set; }
        public string Make { get; set; } = "";
    }
}
